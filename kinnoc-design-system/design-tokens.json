    "grids": {
      "hero": "desktop: headline full width, then [1fr | mosaic auto]; below 1024: single column",
      "two-column": "desktop: 5fr 7fr (Who it is for, Discover) or 7fr 5fr (Communities, Closing CTA); below 1024: single column",
      "steps": "tablet and desktop: 3 equal columns; mobile: single column",
      "mosaic": "desktop and tablet: 5 columns x 4 rows; mobile: 4 columns x 5 rows",
      "footer": "desktop 4fr 2fr 2fr 2fr; tablet 2fr 1fr 1fr 1fr; mobile 2 columns with brand row spanning both"
    }
  },
  "radius": {
    "xs": 4,
    "sm": 8,
    "md": 10,
    "lg": 12,
    "xl": 16,
    "2xl": 20,
    "3xl": 24,
    "4xl": 28,
    "community": "30%",
    "full": 999,
    "use": {
      "button": 12,
      "header-button-compact": 10,
      "chip": 8,
      "audience-image": 14,
      "snippet-tile": "18 (16 on mobile)",
      "preview-card": 20,
      "listing-tile": 20,
      "showcase-stage": "28 / 24 / 0",
      "phone-bezel": 58,
      "phone-screen": 48,
      "community-identity": "30% of its size",
      "person": "full circle"
    }
  },
  "border": {
    "hairline": "1px solid #E7EBF2",
    "chip": "inset 0 0 0 1px #DFE4ED",
    "selected-underline": "inset 0 -2px 0 #0E1B3D",
    "step-rule": "inset 0 3px 0 #0E1B3D"
  },
  "shadow": {
    "preview-card": "0 24px 60px rgba(14,27,61,.14), 0 0 0 1px rgba(14,27,61,.05)",
    "opportunity-snippet": "0 12px 32px rgba(14,27,61,.10), 0 0 0 1px rgba(14,27,61,.06)",
    "phone": "0 50px 90px -30px rgba(14,27,61,.45), inset 0 0 0 1.5px #2A3A63",
    "note": "Only these three. Everything else is flat."
  },
  "motion": {
    "ease-out": "cubic-bezier(.2,.7,.2,1)",
    "state-change": "180ms ease (background, color, box-shadow, transform, opacity)",
    "hero-rise": "700ms ease-out, 14px up, staggered 60 / 140 / 220 / 300 ms",
    "mosaic-pop": "600ms ease-out, scale .94 to 1, staggered 40 ms per tile from 120 ms",
    "swap-fade": "280ms ease, 6px up (tab content)",
    "screen-fade": "380ms ease-out, 8px up (showcase phone screen)",
    "push": "260ms ease-out, 16px from the right (open conversation)",
    "typing-dots": "1.2s loop, 150 ms stagger",
    "reduced-motion": "prefers-reduced-motion: remove every animation and transition"
  },
  "focus": {
    "ring": "2px solid #0068D6",
    "offset": "3px",
    "radius": 10,
    "on-dark": "#7FB8FF",
    "inside-phone": "offset -2px, radius 8px"
  },
  "icon": {

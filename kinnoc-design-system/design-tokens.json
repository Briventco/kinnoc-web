{
  "$schema-note": "Kinnoc website tokens, extracted from the approved design (Claude Design canvas, Home.dc.html). Values are px unless a unit is given. Responsive values are [desktop >=1024, tablet 640-1023, mobile <640].",
  "color": {
    "paper": {
      "$value": "#FFFFFF",
      "$type": "color",
      "role": "Page background, cards, text on dark and blue"
    },
    "ink": {
      "$value": "#0E1B3D",
      "$type": "color",
      "role": "Primary text, headings, the dark Discover section, selected underline"
    },
    "ink-2": {
      "$value": "#4D5B75",
      "$type": "color",
      "role": "Secondary text: leads, descriptions, inactive nav links"
    },
    "ink-3": {
      "$value": "#5E6A82",
      "$type": "color",
      "role": "Tertiary text: eyebrows, meta, timestamps, inactive tabs"
    },
    "navy": {
      "$value": "#1E3A8A",
      "$type": "color",
      "role": "Outgoing chat bubbles, event tiles, community monograms, featured event card"
    },
    "action": {
      "$value": "#0068D6",
      "$type": "color",
      "role": "Primary buttons, links on hover, active states, accent headline line, focus ring"
    },
    "action-pressed": {
      "$value": "#0057B8",
      "$type": "color",
      "role": "Primary button hover and pressed"
    },
    "logo-blue": {
      "$value": "#0086FF",
      "$type": "color",
      "role": "Kinnoc logo colour. On the website it appears only inside the logo files; do not use it for UI text on white (3.6:1)"
    },
    "mist": {
      "$value": "#F4F6FA",
      "$type": "color",
      "role": "Quiet buttons, preview stages, closing CTA band, inputs, update bands"
    },
    "mist-2": {
      "$value": "#E9EDF4",
      "$type": "color",
      "role": "Quiet button hover, neutral monogram tiles"
    },
    "sky": {
      "$value": "#E8F1FF",
      "$type": "color",
      "role": "Pale blue tiles and monograms, own reaction, mention badge"
    },
    "sky-ring": {
      "$value": "#AFC3E8",
      "$type": "color",
      "role": "1px inset ring on selected sky chips"
    },
    "line": {
      "$value": "#E7EBF2",
      "$type": "color",
      "role": "Hairlines, section dividers, header bottom border"
    },
    "chip-border": {
      "$value": "#DFE4ED",
      "$type": "color",
      "role": "1px inset border on interest chips and white monograms"
    },
    "bubble-in": {
      "$value": "#EEF1F6",
      "$type": "color",
      "role": "Incoming chat bubbles, conversation snippet tile, image placeholders"
    },
    "on-navy": {
      "$value": "#C9D8F2",
      "$type": "color",
      "role": "Body text on navy and ink surfaces"
    },
    "amber": {
      "$value": "#B45309",
      "$type": "color",
      "role": "Deadline warnings only (\"Closes in 3 days\"). Never decorative"
    },
    "dark-tile": {
      "$value": "#1A2B55",
      "$type": "color",
      "role": "Listing tiles inside the dark Discover section"
    },
    "dark-label": {
      "$value": "#9FB3D9",
      "$type": "color",
      "role": "Eyebrows and labels on the dark Discover section"
    },
    "dark-accent": {
      "$value": "#7FB8FF",
      "$type": "color",
      "role": "Accent words and focus ring on the dark Discover section"
    },
    "dark-tile-ring": {
      "$value": "#3D5BA8",
      "$type": "color",
      "role": "Inset ring and secondary labels on navy tiles in the dark section"
    },
    "numeral": {
      "$value": "#E3E9F3",
      "$type": "color",
      "role": "Oversized decorative destination number behind the showcase phone"
    },
    "bezel": {
      "$value": "#0E1B3D",
      "$type": "color",
      "role": "Phone frame in the product showcase (same value as ink)"
    }
  },
  "font": {
    "family": {
      "display": {
        "$value": "'Bricolage Grotesque', system-ui, sans-serif",
        "role": "Headings, numbers, dates, monograms, destination names"
      },
      "body": {
        "$value": "'Figtree', system-ui, sans-serif",
        "role": "Everything else: body, UI, buttons, labels"
      }
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "display-weights-used": [
      600,
      700
    ],
    "note": "Display headings are weight 600. Monograms, dates and numerals are 700. Bricolage optical size (opsz) follows font size automatically."
  },
  "type": {
    "display": {
      "size": [
        86,
        64,
        42
      ],
      "line-height": [
        86,
        66,
        44
      ],
      "tracking": [
        -3,
        -2,
        -1.3
      ],
      "weight": 600,
      "family": "display"
    },
    "h2": {
      "size": [
        50,
        42,
        34
      ],
      "line-height": [
        54,
        46,
        38
      ],
      "tracking": -1,
      "weight": 600,
      "family": "display"
    },
    "cta-heading": {
      "size": [
        64,
        54,
        40
      ],
      "line-height": [
        66,
        56,
        42
      ],
      "tracking": [
        -3,
        -2,
        -1.3
      ],
      "weight": 600,
      "family": "display"
    },
    "h3": {
      "size": 26,
      "line-height": 30,
      "tracking": -0.5,
      "weight": 600,
      "family": "display",
      "use": "How it works step titles, desktop showcase item titles"
    },
    "audience-title": {
      "size": [
        26,
        24,
        21
      ],
      "line-height": 1.15,
      "tracking": -0.4,
      "weight": 600,
      "family": "display"
    },
    "tile-title": {
      "size": 22,
      "line-height": 27,
      "weight": 600,
      "family": "display",
      "use": "Discover listing tiles"
    },
    "lead": {
      "size": [
        20,
        19,
        17
      ],
      "line-height": [
        30,
        28,
        26
      ],
      "weight": 400,
      "family": "body",
      "color": "ink-2"
    },
    "body": {
      "size": [
        17,
        17,
        16
      ],
      "line-height": [
        27,
        26,
        25
      ],
      "weight": 400,
      "family": "body",
      "color": "ink-2"
    },
    "ui": {
      "size": 15,
      "line-height": 22,
      "weight": 600,
      "family": "body",
      "use": "Nav links, row text"
    },
    "button": {
      "size": 16,
      "weight": 600,
      "family": "body",
      "note": "Header buttons 15px"
    },
    "eyebrow": {
      "size": 12,
      "line-height": 16,
      "weight": 700,
      "tracking": 1,
      "transform": "uppercase",
      "family": "body",
      "color": "ink-3"
    },
    "meta": {
      "size": 13,
      "line-height": 18,
      "weight": 400,
      "family": "body",
      "color": "ink-3"
    },
    "small-label": {
      "size": 11,
      "line-height": 14,
      "weight": 700,
      "tracking": 1,
      "transform": "uppercase",
      "family": "body",
      "use": "Listing kinds, community kinds"
    }
  },
  "breakpoint": {
    "mobile": "0px",
    "tablet": "640px",
    "desktop": "1024px"
  },
  "layout": {
    "container-max": 1296,
    "container-note": "max-width 1296px including horizontal padding; content width = 1296 - 2 x page-x",
